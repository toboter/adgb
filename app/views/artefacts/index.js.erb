$("#page-result-info").empty();
$("#pagination-results").remove();
<% js = escape_javascript(render(partial: 'artefacts/list', locals: { artefacts: @artefacts })) %>
$("#_results").html("<%= js %>");
$("#page-result-info").attr("data-total", "<%= @pagy&.count.to_i %>").html("<%= escape_javascript(pagy_entries(@pagy, item_name: 'Artefact')) %>");
$('#show-target').empty();
$('#show-target').append('<%= j render(partial: 'artefacts/show', locals: {artefact: @artefacts.first}) %>');
history.replaceState(null, '', "<%= j artefacts_path(request.query_parameters.except(:utf8, :commit, :_)) %>");
